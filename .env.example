# Copie para .env (NÃO versione o .env real) e preencha o que tiver.
# Cada provedor/notificador é ignorado em silêncio se faltar credencial.

# --- Provedores de preço de voo -------------------------------------------
# Amadeus Self-Service (grátis): https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Kiwi.com Tequila: https://tequila.kiwi.com
TEQUILA_API_KEY=

# SerpApi (Google Flights, 100 buscas/mês grátis): https://serpapi.com
SERPAPI_API_KEY=

# Travelpayouts / Aviasales (preços em cache): https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=

# Câmbio p/ converter provedores em USD/EUR (opcional; use valores atuais)
FX_USD_BRL=5.40
FX_EUR_BRL=5.90

# --- Alertas por email (SMTP) ---------------------------------------------
# Gmail/Workspace: gere um App Password em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Alertas por WhatsApp (CallMeBot, grátis) -----------------------------
# 1) Adicione +34 644 51 95 23 aos contatos
# 2) Envie no WhatsApp: "I allow callmebot to send me messages"
# 3) Copie a apikey que ele responder
CALLMEBOT_PHONE=+55DDDNUMERO
CALLMEBOT_APIKEY=
